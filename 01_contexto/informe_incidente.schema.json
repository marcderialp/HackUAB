{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Informe de incidente (nivel 2)",
  "description": "Formato del informe de un incidente investigado. Reescrito para el conjunto de datos de prueba de este repositorio.",
  "type": "object",
  "required": [
    "incident_id",
    "title",
    "alert_ids",
    "patient_zero",
    "initial_access",
    "timeline",
    "scope",
    "root_cause",
    "containment_plan"
  ],
  "properties": {
    "incident_id": {"type": "string"},
    "title": {"type": "string"},
    "alert_ids": {"type": "array", "items": {"type": "string"}},
    "related_incidents": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Otros incidentes de la misma campaña"
    },
    "patient_zero": {"type": "string"},
    "initial_access": {"type": "string"},
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": {"type": "string"},
          "event_id": {"type": "string"},
          "description": {"type": "string"},
          "mitre": {"type": "string"}
        }
      }
    },
    "scope": {
      "type": "object",
      "properties": {
        "users": {"type": "array"},
        "hosts": {"type": "array"},
        "data": {"type": "string"},
        "business_impact": {"type": "string"}
      }
    },
    "root_cause": {"type": "string"},
    "containment_plan": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action": {"type": "string"},
          "target": {"type": "string"},
          "approver": {"type": "string"},
          "business_impact": {"type": "string"}
        }
      }
    },
    "eradication_and_recovery": {"type": "array", "items": {"type": "string"}},
    "notifications": {
      "type": "array",
      "items": {"type": "string"},
      "description": "A quién hay que avisar y en qué plazo"
    },
    "detection_gaps": {"type": "array", "items": {"type": "string"}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "open_questions": {"type": "array", "items": {"type": "string"}}
  }
}
