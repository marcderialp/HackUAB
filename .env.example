# Copy to .env and fill in LLM_API_KEY. Never commit .env.
# The LLM is the hackathon's UAB DCC GPU gateway (OpenAI-compatible); see docs/setup.md.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://dcc-llm-gw.uab.cat/uabthehack/v1
LLM_MODEL=ornith
LLM_API_KEY=<key from the hackathon organizers>
LLM_THINKING=off               # off (default): no reasoning phase, ~15 s per alert; on: 3-5 min and it truncates
# Optional overrides
# LLM_MAX_OUTPUT_TOKENS=4096   # output budget per call, reasoning tokens included
# LLM_TIMEOUT_S=120            # per request; the SDK retries a timeout twice, so up to ~3x per call
# LLM_CACHE_DIR=.cache            # disk cache and call log (read at import time)
# LLM_DISABLE_CACHE=1          # always call the API (skip .cache/llm_cache)
# LLM_OFFLINE=1                # replay from .cache/llm_cache only, no API calls (demo safety net)
